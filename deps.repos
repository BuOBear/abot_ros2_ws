# The official YDLIDAR ROS2 driver has a Humble branch but no Humble binary on
# this development host. Install the pinned YDLidar-SDK separately first.
repositories:
  ydlidar_ros2_driver:
    type: git
    url: https://github.com/YDLIDAR/ydlidar_ros2_driver.git
    version: 4ef70d3f32a85704ade0be54b214f3763b1ab3e8
