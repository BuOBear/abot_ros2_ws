# Empty prompt is rejected. The camera frame is snapshotted when execution starts.
# A nonpositive limit selects the node's configured default.
string prompt
float32 max_frame_age_sec
float32 timeout_sec
---
uint8 OK=0
uint8 NO_FRAME=1
uint8 STALE_FRAME=2
uint8 UNAVAILABLE=3
uint8 TIMEOUT=4
uint8 BACKEND_ERROR=5
uint8 CANCELED=6
uint8 INVALID_IMAGE=7
uint8 code
string text
---
string stage
