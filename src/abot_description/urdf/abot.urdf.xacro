<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="abot">
  <!-- Legacy CAD/URDF values are candidates, not measured calibration. The
       original STL coordinates appear to be meters and are used unscaled. -->
  <xacro:property name="base_footprint_z" value="0.0"/>
  <xacro:property name="laser_xyz" value="0.06 0 0.18"/>
  <xacro:property name="imu_xyz" value="0 0 0"/>
  <xacro:property name="camera_xyz" value="0.130670132360421 0.000184007776624636 0.128393640072318"/>

  <!-- EKF owns odom -> base_footprint; robot_state_publisher owns this tree. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_footprint_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://abot_description/meshes/base_link.STL"/></geometry>
      <material name="body"><color rgba="0.22352 0.89019 0.77647 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://abot_description/meshes/base_link.STL"/></geometry>
    </collision>
  </link>

  <!-- The suffixes and poses follow the ROS 1 CAD model. The wheel rotation
       axis and front/rear wheel order still require M0 hardware verification. -->
  <xacro:macro name="wheel" params="name xyz">
    <link name="link_${name}">
      <visual>
        <geometry><mesh filename="package://abot_description/meshes/link_${name}.STL"/></geometry>
        <material name="wheel"><color rgba="0 0 0 0.95"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://abot_description/meshes/link_${name}.STL"/></geometry>
      </collision>
    </link>
    <joint name="joint_${name}" type="continuous">
      <parent link="base_link"/>
      <child link="link_${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="left_w" xyz="0.12024 0.10802 0.028264"/>
  <xacro:wheel name="left_s" xyz="-0.12144 0.11128 0.028375"/>
  <xacro:wheel name="right_w" xyz="0.12024 -0.10899 0.028264"/>
  <xacro:wheel name="right_s" xyz="-0.12024 -0.10696 0.028161"/>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.040"/></geometry>
      <material name="laser"><color rgba="0 0 0 0.95"/></material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${laser_xyz}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><mesh filename="package://abot_description/meshes/camera_link.STL"/></geometry>
      <material name="camera"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://abot_description/meshes/camera_link.STL"/></geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- REP 103 camera optical axes: z forward, x right, y down. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
</robot>
